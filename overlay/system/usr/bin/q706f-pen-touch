#!/usr/bin/python3
"""Expose the Lenovo Precision Pen as a single-point touchscreen.

Mir (the Lomiri compositor) has no support for tablet-tool devices, so pen events
from the Goodix digitizer are otherwise ignored. Presenting the pen as an absolute
mouse does not work either: Lomiri moves its cursor by relative deltas, so the
cursor keeps a constant offset from the tip. A touch contact is positioned exactly,
so this daemon grabs the pen node and re-emits tip contacts through uinput as a
direct-touch device ("q706f pen touch").

The Goodix driver raises BTN_TOUCH whenever the pen is in range, hovering included,
so the tip is considered down only while ABS_PRESSURE is above a small threshold.

The digitizer reports in the panel's portrait frame (1600x2560); the display is
driven as 2560x1600, so coordinates are rotated the same way as the touchscreen.

Pressure
--------
The contact carries ABS_MT_PRESSURE (raw 0..4095 of the pen, at least 1 while the
contact is down). Nothing in the stock system consumes it yet: libinput (1.25) has
no touch-pressure API, so Mir 1.8 (src/platforms/evdev/libinput_device.cpp) reports
a constant 0.8 for every touch and qtmir/qtubuntu turn that into a constant
TouchPoint.pressure of 0.625. The axis is there so that a patched Mir (or anything
reading the evdev node / EVIOCGMTSLOTS) can pick the real value up. libinput ignores
the axis on direct-touch devices, so it does not change positioning.
Set "pressure = off" in the config file to get the old axis set back.

Barrel buttons
--------------
Lomiri has no right click for touch, and a mouse button from a device without
pointer motion would act at the (unrelated) cursor position. The mappings are:

  hold        While the button is held with the pen hovering, a stationary contact
              is kept at the position the pen had when the button went down; it is
              lifted when the button is released or the pen leaves range. A short
              click is a tap, holding it is a press-and-hold (context menu, text
              selection, ...) that cannot be broken by hand tremor. Ignored while
              the tip is already drawing.
  key:A+B     Tap a key combination on a second uinput device ("q706f pen buttons"),
              e.g. key:KEY_LEFTCTRL+KEY_Z. The device only has the listed keys, so
              udev does not tag it as a keyboard and the on-screen keyboard stays.
  none        Ignore the button.

Defaults: button1 (BTN_STYLUS) = hold, button2 (BTN_STYLUS2) = key:KEY_ESC.

Optional config file /etc/q706f-pen-touch.conf, "name = value" lines:
  pressure = on|off
  button1  = hold | longpress | none | key:KEY_...[+KEY_...]
  button2  = (same)
"""
import argparse
import select
import sys
import time

import evdev
from evdev import AbsInfo, UInput, ecodes as e

PEN_NAME = "goodix_ts,pen"
TOUCH_NAME = "q706f pen touch"
KEYS_NAME = "q706f pen buttons"
CONFIG_PATH = "/etc/q706f-pen-touch.conf"

PRESSURE_DOWN = 30    # of 4095: tip is touching the glass
PRESSURE_UP = 10      # hysteresis so a light stroke does not break up
PRESSURE_MAX = 4095
HOLD_PRESSURE = 2048  # pressure reported for a button-generated contact
LONGPRESS_S = 1.0     # length of the contact generated by the "longpress" action

DEFAULTS = {
    "pressure": "on",
    "button1": "hold",
    # The Precision Pen 3 has a single barrel button and reports it as BTN_STYLUS2.
    "button2": "key:KEY_ESC",
}
BUTTONS = {e.BTN_STYLUS: "button1", e.BTN_STYLUS2: "button2"}


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def parse_action(text):
    """Return None, "hold", "longpress" or a tuple of key codes; raise ValueError if invalid."""
    text = text.strip()
    if text in ("", "none", "off"):
        return None
    if text in ("hold", "longpress"):
        return text
    if text.startswith("key:"):
        keys = []
        for name in text[4:].split("+"):
            code = e.ecodes.get(name.strip().upper())
            if code is None or not name.strip().upper().startswith("KEY_"):
                raise ValueError("unknown key %r" % name)
            keys.append(code)
        if keys:
            return tuple(keys)
    raise ValueError("unknown action %r" % text)


def load_config(path):
    raw = dict(DEFAULTS)
    try:
        with open(path) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if "=" not in line:
                    continue
                name, value = (s.strip() for s in line.split("=", 1))
                if name in raw:
                    raw[name] = value
                else:
                    log("%s: unknown setting %r ignored" % (path, name))
    except FileNotFoundError:
        pass
    except OSError as err:
        log("%s: %s; using defaults" % (path, err))
        raw = dict(DEFAULTS)

    cfg = {"pressure": raw["pressure"].lower() not in ("off", "0", "no", "false")}
    for name in ("button1", "button2"):
        try:
            cfg[name] = parse_action(raw[name])
        except ValueError as err:
            log("%s: %s; using default" % (name, err))
            cfg[name] = parse_action(DEFAULTS[name])
    return cfg


class Translator:
    """Turn pen events into touch-contact frames (and key taps).

    `touch` and `keys` only need write(type, code, value) and syn(); `keys` may be
    None, in which case key actions are dropped.
    """

    def __init__(self, src_w, src_h, touch, keys, cfg):
        self.src_w = src_w
        self.src_h = src_h
        self.touch = touch
        self.keys = keys
        self.cfg = cfg
        self.x = self.y = None
        self.pressure = 0
        self.down = False        # a contact is currently reported
        self.want_down = False   # tip state derived from pressure
        self.in_range = False
        self.tracking_id = 0
        self.buttons = {}        # button code -> pressed, as last seen
        self.pending = []        # (button code, pressed) edges of this frame
        self.hold = None         # (button code, x, y) while a hold contact is active
        self.lp = None           # (deadline, x, y) while a timed long-press is active
        self.clock = time.monotonic

    def feed(self, etype, code, value):
        if etype == e.EV_ABS:
            if code == e.ABS_X:
                self.y = self.src_w - value
                self.in_range = True
            elif code == e.ABS_Y:
                self.x = value
                self.in_range = True
            elif code == e.ABS_PRESSURE:
                self.pressure = value
                if value >= PRESSURE_DOWN:
                    self.want_down = True
                elif value <= PRESSURE_UP:
                    self.want_down = False
        elif etype == e.EV_KEY:
            if code in (e.BTN_TOUCH, e.BTN_TOOL_PEN):
                self.in_range = bool(value)
                if value == 0:
                    self.want_down = False
            elif code in BUTTONS and value in (0, 1):
                if self.buttons.get(code, False) != bool(value):
                    self.buttons[code] = bool(value)
                    self.pending.append((code, bool(value)))
        elif etype == e.EV_SYN and code == e.SYN_REPORT:
            self.frame()

    def frame(self):
        have_pos = self.x is not None and self.y is not None
        tip = self.want_down and have_pos

        for code, pressed in self.pending:
            action = self.cfg.get(BUTTONS[code])
            if action == "hold":
                if pressed:
                    # Never disturb a stroke that is already being drawn.
                    if self.hold is None and not self.down and not tip \
                            and self.in_range and have_pos:
                        self.hold = (code, self.x, self.y)
                elif self.hold and self.hold[0] == code:
                    self.end_hold()
            elif action == "longpress":
                # A timed stationary contact where the tip was last seen: the touch
                # equivalent of a right click. The driver drops BTN_TOOL_PEN while the
                # button is down, so this must not depend on the pen staying in range.
                if pressed and self.lp is None and self.hold is None \
                        and not self.down and not tip and have_pos:
                    self.lp = (self.clock() + LONGPRESS_S, self.x, self.y)
            elif action and pressed:
                self.tap_keys(action)
        self.pending = []

        if self.lp:
            self.contact(self.lp[1], self.lp[2], HOLD_PRESSURE)
            return

        if self.hold and not self.in_range:
            self.end_hold()

        if self.hold:
            self.contact(self.hold[1], self.hold[2], HOLD_PRESSURE)
        elif tip:
            self.contact(self.x, self.y, min(max(self.pressure, 1), PRESSURE_MAX))
        else:
            self.release()

    def timeout(self):
        """Seconds until tick() must run, or None when nothing is pending."""
        if self.lp is None:
            return None
        return max(self.lp[0] - self.clock(), 0.0)

    def tick(self):
        if self.lp and self.clock() >= self.lp[0]:
            self.lp = None
            self.release()   # a tip that is down afterwards starts a fresh contact

    def end_hold(self):
        self.hold = None
        self.release()   # a tip that is down afterwards starts a fresh contact

    def contact(self, x, y, pressure):
        w = self.touch.write
        if not self.down:
            self.tracking_id = (self.tracking_id + 1) % 65536
            w(e.EV_ABS, e.ABS_MT_SLOT, 0)
            w(e.EV_ABS, e.ABS_MT_TRACKING_ID, self.tracking_id)
            w(e.EV_KEY, e.BTN_TOUCH, 1)
            self.down = True
        w(e.EV_ABS, e.ABS_MT_POSITION_X, x)
        w(e.EV_ABS, e.ABS_MT_POSITION_Y, y)
        if self.cfg.get("pressure"):
            w(e.EV_ABS, e.ABS_MT_PRESSURE, pressure)
        self.touch.syn()

    def release(self):
        if not self.down:
            return
        w = self.touch.write
        if self.cfg.get("pressure"):
            w(e.EV_ABS, e.ABS_MT_PRESSURE, 0)
        w(e.EV_ABS, e.ABS_MT_TRACKING_ID, -1)
        w(e.EV_KEY, e.BTN_TOUCH, 0)
        self.touch.syn()
        self.down = False

    def tap_keys(self, keys):
        if self.keys is None:
            return
        for k in keys:
            self.keys.write(e.EV_KEY, k, 1)
            self.keys.syn()
        for k in reversed(keys):
            self.keys.write(e.EV_KEY, k, 0)
            self.keys.syn()


def find_pen(name):
    for path in evdev.list_devices():
        dev = evdev.InputDevice(path)
        if dev.name == name:
            return dev
        dev.close()
    return None


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    # The options exist for testing against a fake pen; the service uses the defaults.
    ap.add_argument("--source-name", default=PEN_NAME)
    ap.add_argument("--touch-name", default=TOUCH_NAME)
    ap.add_argument("--keys-name", default=KEYS_NAME)
    ap.add_argument("--config", default=CONFIG_PATH)
    args = ap.parse_args()

    cfg = load_config(args.config)

    pen = None
    for _ in range(60):
        pen = find_pen(args.source_name)
        if pen:
            break
        time.sleep(1)
    if not pen:
        log("pen device not found")
        return 1

    absinfo = dict(dict(pen.capabilities(absinfo=True)).get(e.EV_ABS, []))
    src_w = absinfo[e.ABS_X].max   # 1600, short edge
    src_h = absinfo[e.ABS_Y].max   # 2560, long edge

    axes = [
        (e.ABS_MT_SLOT, AbsInfo(0, 0, 0, 0, 0, 0)),
        (e.ABS_MT_TRACKING_ID, AbsInfo(0, 0, 65535, 0, 0, 0)),
        (e.ABS_MT_POSITION_X, AbsInfo(0, 0, src_h, 0, 0, 9)),
        (e.ABS_MT_POSITION_Y, AbsInfo(0, 0, src_w, 0, 0, 9)),
    ]
    if cfg["pressure"]:
        axes.append((e.ABS_MT_PRESSURE, AbsInfo(0, 0, PRESSURE_MAX, 0, 0, 0)))
    ui = UInput(
        {e.EV_KEY: [e.BTN_TOUCH], e.EV_ABS: axes},
        name=args.touch_name,
        vendor=0x17EF,
        product=0x0002,
        input_props=[e.INPUT_PROP_DIRECT],
    )

    # Only the keys that are actually mapped, so that neither udev nor Mir take the
    # device for a real (alphanumeric) keyboard.
    key_codes = sorted({k for name in ("button1", "button2")
                        if isinstance(cfg[name], tuple) for k in cfg[name]})
    keys = None
    if key_codes:
        try:
            keys = UInput({e.EV_KEY: key_codes}, name=args.keys_name,
                          vendor=0x17EF, product=0x0003)
        except OSError as err:
            log("cannot create key device (%s); key actions disabled" % err)

    log("pen %s: pressure=%s button1=%s button2=%s" % (
        pen.path, "on" if cfg["pressure"] else "off",
        cfg["button1"] or "none", cfg["button2"] or "none"))

    tr = Translator(src_w, src_h, ui, keys, cfg)
    pen.grab()  # keep libinput from seeing the raw (unsupported) tablet device
    try:
        while True:
            ready, _, _ = select.select([pen.fd], [], [], tr.timeout())
            if ready:
                for ev in pen.read():
                    tr.feed(ev.type, ev.code, ev.value)
            tr.tick()
    finally:
        try:
            pen.ungrab()
        except OSError:
            pass
        ui.close()
        if keys:
            keys.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
